# Resolución estricta: una dependencia no declarada no se resuelve.
# Las dependencias fantasma aparecen en pnpm install, no en docker build.
node-linker=isolated

# El ecosistema NestJS declara muchos peers; instalarlos a mano es ruido.
auto-install-peers=true

# En CI, cualquier desincronización del lockfile debe romper el build.
prefer-frozen-lockfile=true