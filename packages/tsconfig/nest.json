{
    "extends": "./base.json",
    "display": "NestJS service",
    "compilerOptions": {
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "**/*.spec.ts",
        "**/*.e2e-spec.ts"
    ]
}